# Copiá este archivo a .env y completá tu clave. NUNCA subas el .env a GitHub.

# --- Proveedor del LLM: gemini | openai | anthropic ---
LLM_PROVIDER=gemini

# --- API keys (solo hace falta la del proveedor elegido) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Modelos (opcional; si se omiten se usan los valores por defecto) ---
# IDs reales (ver tabla "Modelos" del README). Gemini: Flash Lite tiene 500 requests/día en el plan
# gratuito (los Flash, 20). Respaldo si se agota el cupo diario: gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Parámetros del LLM (opcional) ---
# Se envía a OpenAI y Gemini 2.x; con Gemini 3.x y Anthropic se ignora con un aviso (sampling fijo / 400).
# LLM_TEMPERATURE=0
LLM_THINKING_LEVEL=low             # solo Gemini 3: low | medium | high
LLM_MAX_TOKENS=4096                # el investigador registra ~20 métricas con su cita en una sola llamada
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2                  # reintentos propios ante errores transitorios (nunca el cupo diario)
LLM_REQUESTS_PER_MINUTE=12         # Flash Lite permite 15/min en el plan gratuito; se deja margen

# --- Búsqueda web del investigador (opcional) ---
# Sin clave, buscar_mercado usa los informes de mercado locales (data/mercado).
TAVILY_API_KEY=

# --- Orquestador (opcional; estos son los valores por defecto) ---
# DD_MAX_PASOS=12                    # decisiones del supervisor por análisis (la última siempre cierra)
# DD_MAX_INTENTOS_INVESTIGADOR=3     # veces que se puede delegar en cada especialista
# DD_MAX_INTENTOS_ANALISTA=3
# DD_MAX_INTENTOS_CRITICO=2
# DD_MAX_ITERACIONES_ESPECIALISTA=6  # rondas de herramientas por invocación de un especialista
# DD_RECURSION_LIMIT=40              # techo duro de LangGraph (debe superar 2 * DD_MAX_PASOS + 3)
# DD_MODELO_SUPERVISOR=              # modelo propio para el supervisor (por defecto, el mismo)
